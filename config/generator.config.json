{
  "provider": "gemini",
  "gemini_models": [
    "gemini-3.8-flash",
    "gemini-3.5-flash"
  ],
  "groq_model": "openai/gpt-oss-120b",
  "cards_per_day": 15,
  "batch_size": 5,
